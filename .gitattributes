# Sources (.c/.h/.rc) and docs/ are UTF-8 without BOM. Normalize EOL to CRLF.
*.c       text eol=crlf
*.h       text eol=crlf
*.rc      text eol=crlf
*.def     text eol=crlf
*.sln     text eol=crlf
*.vcxproj text eol=crlf
*.filters text eol=crlf
*.xml     text eol=crlf
*.txt     text eol=crlf
*.html    text eol=crlf
*.md      text eol=crlf
*.ps1     text eol=crlf
*.py      text eol=lf
*.yml     text eol=lf

*.ico binary
*.bmp binary
*.cur binary
