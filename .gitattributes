# Sources are Shift_JIS (CP932) with CRLF line endings. Keep bytes as-is, normalize EOL to CRLF.
*.c       text eol=crlf
*.h       text eol=crlf
*.rc      text eol=crlf
*.def     text eol=crlf
*.sln     text eol=crlf
*.vcxproj text eol=crlf
*.filters text eol=crlf
*.xml     text eol=crlf
*.txt     text eol=crlf
*.html    text eol=crlf
*.md      text eol=crlf

*.ico binary
*.bmp binary
*.cur binary
