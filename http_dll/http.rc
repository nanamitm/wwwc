IDD_DIALOG_HTTPPROP_ARCHIVE DIALOG 0, 0, 227, 225
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Archive"
FONT 8, "MS Shell Dlg"
BEGIN
    GROUPBOX        "Archive",IDC_STATIC,5,5,215,160
    CONTROL         "Archive the &checked page",IDC_CHECK_ARCHIVE,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,15,18,195,10
    CONTROL         "Archive &images",IDC_CHECK_ARCHIVE_IMAGE,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,25,34,185,10
    CONTROL         "Archive &style sheets (CSS)",IDC_CHECK_ARCHIVE_CSS,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,25,48,185,10
    CONTROL         "Archive &JavaScript",IDC_CHECK_ARCHIVE_JS,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,25,62,185,10
    CONTROL         "Save the page as shown in a &browser",IDC_CHECK_ARCHIVE_BROWSER,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,25,76,185,10
    LTEXT           "&Generations to keep:",IDC_STATIC,25,94,83,8
    EDITTEXT        IDC_EDIT_ARCHIVE_GEN,110,92,30,12,ES_RIGHT | ES_AUTOHSCROLL | ES_NUMBER
    LTEXT           "(0-999)",IDC_STATIC,145,94,40,8
    LTEXT           "The page is archived when a check finds it updated. 0 generations keeps all. If JavaScript is archived, its scripts run when you open the archive. Saving the page as shown in a browser runs Edge in the background and also saves the data loaded by scripts.",IDC_STATIC,15,110,195,52
    PUSHBUTTON      "&Delete Archive",IDC_BUTTON_ARCHIVE_DELETE,10,172,100,14
    LTEXT           "Archiving is disabled in the protocol settings.",IDC_STATIC_ARCHIVE_GLOBAL,10,190,205,10
    LTEXT           "Items with authentication are not archived.",IDC_STATIC_ARCHIVE_AUTH,10,202,205,10
    LTEXT           "No browser was found, so the page is saved as downloaded.",IDC_STATIC_ARCHIVE_NOBROWSER,10,214,205,10
END

