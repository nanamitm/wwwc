IDD_DIALOG_HTTPPROP_ARCHIVE DIALOG 0, 0, 227, 225
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "アーカイブ"
FONT 9, "ＭＳ Ｐゴシック"
BEGIN
    GROUPBOX        "アーカイブ",IDC_STATIC,5,5,215,160
    CONTROL         "チェックしたページをアーカイブする(&C)",IDC_CHECK_ARCHIVE,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,15,18,195,10
    CONTROL         "画像をアーカイブする(&I)",IDC_CHECK_ARCHIVE_IMAGE,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,25,34,185,10
    CONTROL         "スタイルシート(CSS)をアーカイブする(&S)",IDC_CHECK_ARCHIVE_CSS,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,25,48,185,10
    CONTROL         "JavaScriptをアーカイブする(&J)",IDC_CHECK_ARCHIVE_JS,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,25,62,185,10
    CONTROL         "ブラウザで表示した内容を保存する(&B)",IDC_CHECK_ARCHIVE_BROWSER,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,25,76,185,10
    LTEXT           "保存する世代数(&G):",IDC_STATIC,25,94,75,8
    EDITTEXT        IDC_EDIT_ARCHIVE_GEN,100,92,30,12,ES_RIGHT | ES_AUTOHSCROLL | ES_NUMBER
    LTEXT           "(0～999)",IDC_STATIC,135,94,40,8
    LTEXT           "ページが更新されていた場合にアーカイブします。世代数が 0 の場合は上限なしで保存します。JavaScriptをアーカイブすると、開いたときにスクリプトが実行されます。「ブラウザで表示した内容を保存する」にすると、Microsoft Edge などを裏で実行し、スクリプトで読み込んだデータも表示どおりに保存します。",IDC_STATIC,15,112,195,50
    PUSHBUTTON      "アーカイブを削除(&D)",IDC_BUTTON_ARCHIVE_DELETE,10,172,100,14
    LTEXT           "全体設定でアーカイブが無効になっています。",IDC_STATIC_ARCHIVE_GLOBAL,10,190,205,10
    LTEXT           "認証を設定したアイテムはアーカイブしません。",IDC_STATIC_ARCHIVE_AUTH,10,202,205,10
    LTEXT           "ブラウザが見つからないため、取得したページをそのまま保存します。",IDC_STATIC_ARCHIVE_NOBROWSER,10,214,205,10
END

